import Foundation

// MARK: - Шаблон файла секретов
// Как использовать: скопировать этот файл как Secrets.swift (в эту же папку)
// и вписать реальный ключ. Secrets.swift в git не попадает.
// Расширение .example не компилируется — конфликта имён не будет.

// nonisolated — читается из фоновых сервисов конвейера Refresh
nonisolated enum Secrets {

    /// Ключ Anthropic API для распознавания изображений и подтверждения вердикта
    static let visionAPIKey = "PASTE-YOUR-ANTHROPIC-API-KEY-HERE"
}
